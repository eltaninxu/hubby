# Copy to .env and fill in. Nothing here is a real secret.
# Paypal sandbox keys: https://developer.paypal.com/dashboard/applications/sandbox

# Only "sandbox" is supported. The app refuses to start otherwise.
PAYPAL_ENV=sandbox

# From your sandbox REST app (Client ID / Secret).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Where PayPal sends the buyer back to. Local: http://localhost:8080
# Deployed: https://<your-domain>
PAYPAL_RETURN_BASE=http://localhost:8080

# Where approved money is released to (your sandbox *personal* account email).
HUBBY_RECIPIENT_EMAIL=

# Any OpenAI-compatible endpoint works (OpenAI, LiteLLM, Ollama /v1, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=
# A chat model that endpoint actually serves and that supports tool calling.
LLM_MODEL=

# Host port for docker compose. Leave empty for 8080.
HUBBY_PORT=8080
